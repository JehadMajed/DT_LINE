[Unit]
Description=Digital Twin - Serial <-> MQTT bridge (ESP32 telemetry + commands)
# Start after network and (if present) the local mosquitto broker.
After=network-online.target mosquitto.service
Wants=network-online.target
# Don't let systemd give up after repeated fast restarts.
StartLimitIntervalSec=0

[Service]
Type=simple
User=jehadroot
WorkingDirectory=/home/jehadroot/DT_LINE
ExecStart=/usr/bin/python3 -u /home/jehadroot/DT_LINE/serial_mqtt_bridge.py
# Give the USB serial adapter a moment to enumerate after a cold boot.
ExecStartPre=/bin/sleep 5
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
